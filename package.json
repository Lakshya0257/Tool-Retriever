{
  "name": "tool-retriever",
  "version": "0.1.0",
  "description": "Send your agent the few tools it needs for the current step, not the whole manual. Keyword, semantic and hybrid tool retrieval for any agent loop and MCP server.",
  "keywords": [
    "agent",
    "agents",
    "llm",
    "tools",
    "tool-calling",
    "function-calling",
    "tool-retrieval",
    "mcp",
    "model-context-protocol",
    "bm25",
    "embeddings",
    "rag",
    "openai",
    "anthropic"
  ],
  "license": "MIT",
  "author": "Lakshya Bhati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lakshya0257/Tool-Retriever.git"
  },
  "homepage": "https://github.com/Lakshya0257/Tool-Retriever#readme",
  "bugs": {
    "url": "https://github.com/Lakshya0257/Tool-Retriever/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "ai": "^7.0.179",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
